#!/usr/bin/env bash
# lean-agent: install the plugin and launch low-token Claude Code agents
# that you drive from the Claude app via Remote Control.
set -euo pipefail

REPO="mcmadsen/lean-agent"
PLUGIN="lean-agent@lean-agent"

usage() {
  cat <<'EOF'
Usage: lean-agent <command> [options]

Commands:
  install                 Add this repo as a plugin marketplace and install the plugin
  up [options] [DIR]      Start `claude remote-control` in DIR with lean defaults
  budget [SESSION|FILE]   Show token usage for a session (default: latest in this dir)
  env [--json]            Print the lean environment defaults (shell or settings.json form)

Options for `up`:
  --budget N              Per-session budget in weighted tokens (default: $LEAN_AGENT_BUDGET or 2000000)
  --model M               Main model, e.g. sonnet or opus (default: your configured model)
  --subagent-model M      Model for subagents (default: haiku)
  --name NAME             Session name shown in the Claude app (default: lean: <dir name>)
  --permission-mode MODE  e.g. acceptEdits, auto (default: Claude's default)
  --worktree              Give each remote session its own git worktree

Any env var you already set (see `lean-agent env`) wins over these defaults.
EOF
}

# Defaults applied by `up`; existing environment values take precedence.
lean_env() {
  echo "CLAUDE_CODE_SUBAGENT_MODEL=${CLAUDE_CODE_SUBAGENT_MODEL:-haiku}"
  echo "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE:-70}"
  echo "BASH_MAX_OUTPUT_LENGTH=${BASH_MAX_OUTPUT_LENGTH:-20000}"
  echo "MAX_MCP_OUTPUT_TOKENS=${MAX_MCP_OUTPUT_TOKENS:-10000}"
  echo "LEAN_AGENT_BUDGET=${LEAN_AGENT_BUDGET:-2000000}"
  echo "LEAN_AGENT_WARN_PCT=${LEAN_AGENT_WARN_PCT:-80}"
}

need_claude() {
  command -v claude >/dev/null 2>&1 || { echo "lean-agent: 'claude' not found on PATH" >&2; exit 1; }
}

cmd_install() {
  need_claude
  claude plugin marketplace add "$REPO" || true   # already added is fine
  claude plugin install "$PLUGIN"
  echo "Installed. Restart open Claude Code / Claude Desktop sessions to load it."
}

cmd_env() {
  if [[ "${1:-}" == "--json" ]]; then
    echo '{'
    echo '  "env": {'
    lean_env | sed -E 's/^([^=]+)=(.*)$/    "\1": "\2",/' | sed '$ s/,$//'
    echo '  }'
    echo '}'
  else
    lean_env | sed 's/^/export /'
  fi
}

cmd_up() {
  need_claude
  local dir="." model="" name="" pmode="" spawn=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --budget) export LEAN_AGENT_BUDGET="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --subagent-model) export CLAUDE_CODE_SUBAGENT_MODEL="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --permission-mode) pmode="$2"; shift 2 ;;
      --worktree) spawn="worktree"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) echo "lean-agent: unknown option $1" >&2; exit 2 ;;
      *) dir="$1"; shift ;;
    esac
  done
  cd "$dir"
  [[ -n "$name" ]] || name="lean: $(basename "$PWD")"

  if ! claude plugin list 2>/dev/null | grep -q "lean-agent"; then
    echo "lean-agent: plugin not installed; run 'lean-agent install' first (continuing without it)" >&2
  fi

  while IFS='=' read -r k v; do export "$k=$v"; done < <(lean_env)

  local args=()
  [[ -n "$model" ]] && args+=(--model "$model")   # global flag, carried into remote-control
  args+=(remote-control --name "$name")
  [[ -n "$pmode" ]] && args+=(--permission-mode "$pmode")
  [[ -n "$spawn" ]] && args+=(--spawn "$spawn")

  echo "lean-agent: budget ${LEAN_AGENT_BUDGET} weighted tokens/session, subagents on ${CLAUDE_CODE_SUBAGENT_MODEL}"
  echo "lean-agent: open the Claude app (Code) and pick \"$name\" to drive it"
  exec claude "${args[@]}"
}

cmd_budget() {
  local root
  root="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
  local script="$root/plugins/lean-agent/scripts/usage.py"
  if [[ ! -f "$script" ]]; then
    script="$(ls -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/plugins/cache/*/lean-agent/*/scripts/usage.py 2>/dev/null | tail -1)"
  fi
  [[ -f "$script" ]] || { echo "lean-agent: usage.py not found" >&2; exit 1; }
  exec python3 "$script" report "$@"
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  up) shift; cmd_up "$@" ;;
  budget) shift; cmd_budget "$@" ;;
  env) shift; cmd_env "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "lean-agent: unknown command $1" >&2; usage >&2; exit 2 ;;
esac
